# Copy to .env.local and fill in. .env.local is ignored by git, and Docker
# Compose reads it too.

# Required for runs. Create a key in the Claude Console. Never commit it.
ANTHROPIC_API_KEY=

# Optional. The models the engine uses.
# WINDTUNNEL_MODEL_REASONING=claude-opus-5-5
# WINDTUNNEL_MODEL_AGENTS=claude-sonnet-5-5

# Optional. Where Postgres is. This default matches docker-compose.yml when the
# app runs on your machine (`pnpm dev`). Inside Docker, Compose sets it.
# DATABASE_URL=postgres://windtunnel:windtunnel-dev-only@localhost:5433/windtunnel

# Optional. The public address of the app, used for links in share cards.
# WINDTUNNEL_URL=http://localhost:3300

# Optional. Lets runs read private GitHub repositories. A fine-grained token
# with read-only "Contents" access is enough. Never commit it.
# GITHUB_TOKEN=

# Optional. The folder on this machine whose subfolders can be picked as
# local repositories when running in Docker. Defaults to ./repos.
# WINDTUNNEL_REPOS_HOST_DIR=/path/to/your/code
